<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.gymmanager">

    <application
        android:allowBackup="true"
        android:icon="@drawable/gym_logo"
        android:label="FitTrack Gym"
        android:roundIcon="@drawable/gym_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar"
        >

        <activity android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".MainActivity" />
        <activity android:name=".AddMemberActivity" />
        <activity android:name=".MemberListActivity" />
        <activity android:name=".MemberDetailsActivity" />

    </application>
</manifest>